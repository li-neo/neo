# ============================================================
# Neo Project Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---------- General ----------
APP_NAME=neo
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=neo
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=neo

# ---------- FastAPI ----------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Next.js ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---------- Hugging Face ----------
HF_TOKEN=
HF_API_URL=https://huggingface.co/api

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------- OpenClaw (OpenAI-compatible LLM) ----------
# e.g. http://localhost:11434 for Ollama, or any OpenAI-compatible API
OPENCLAW_API_URL=
OPENCLAW_API_KEY=

# ---------- MCP ----------
MCP_ENABLED=false
MCP_ENDPOINT=

# ---------- Deploy (Volcengine) ----------
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_KEY_PATH=~/.ssh/id_rsa
