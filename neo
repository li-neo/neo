#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  LINK_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$LINK_DIR/$SOURCE_PATH"
done
ROOT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
CLI_VENV_PYTHON="$ROOT_DIR/.venv-cli/bin/python"
VENV_PYTHON="$ROOT_DIR/server/.venv/bin/python"

if [[ -x "$CLI_VENV_PYTHON" ]]; then
  export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
  exec "$CLI_VENV_PYTHON" -m tools.neo_cli.main "$@"
fi

if [[ -x "$VENV_PYTHON" ]]; then
  export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
  exec "$VENV_PYTHON" -m tools.neo_cli.main "$@"
fi

export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m tools.neo_cli.main "$@"
